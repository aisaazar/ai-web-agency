# AI Web Agency local/dev configuration
# Never place real secrets in this file.

# Public build-time configuration for client-site lead forms.
NEXT_PUBLIC_AGENCY_LEAD_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AGENCY_SITE_ID=

# Dashboard server-side API and tenant selection.
AGENCY_API_URL=http://127.0.0.1:8000
AGENCY_ORG_ID=

# Public customer-agent integration.
NEXT_PUBLIC_AGENCY_AGENT_API_URL=
NEXT_PUBLIC_AGENCY_CLIENT_ID=

# Runtime mode. Production enforces HTTPS origins and secure auth cookies.
AGENCY_ENV=development
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AGENCY_TURNSTILE_SECRET=

# API CORS: comma-separated trusted site origins.
AGENCY_ALLOWED_ORIGINS=http://localhost:3000

# Auth session cookie; set true behind HTTPS in production.
AGENCY_COOKIE_SECURE=false
AGENCY_AGENT_COOKIE_SAMESITE=lax

# Server-side provider placeholders (names only; never commit credentials).
AGENCY_DATABASE_URL=sqlite:///agency.db
AGENCY_PROVIDER_MODE=mock
AGENCY_RESEARCH_PROVIDER=mock

# LLM: mock for deterministic tests; local uses an OpenAI-compatible local endpoint.
AGENCY_LLM_PROVIDER=mock
AGENCY_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
AGENCY_LOCAL_LLM_MODEL=qwen3:0.6b
AGENCY_LOCAL_LLM_API_KEY=

# Lead notifications: console is offline-safe; smtp is optional for real deployments.
AGENCY_NOTIFY_PROVIDER=console
AGENCY_SMTP_HOST=
AGENCY_SMTP_PORT=587
AGENCY_SMTP_USERNAME=
AGENCY_SMTP_PASSWORD=
AGENCY_SMTP_FROM=

# Deployment provider for dashboard preview creation: local_static (offline-safe) or vercel.
AGENCY_DEPLOY_PROVIDER=local_static

# Vercel deployment (only required when AGENCY_DEPLOY_PROVIDER=vercel).
# Use a token scoped to the target project; never put it in client builds.
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
