# AI Web Agency local/dev configuration
# Never place real secrets in this file.

# Public build-time configuration for client-site lead forms.
NEXT_PUBLIC_AGENCY_LEAD_API_URL=http://127.0.0.1:8091
NEXT_PUBLIC_AGENCY_SITE_ID=

# API CORS: comma-separated trusted site origins.
AGENCY_ALLOWED_ORIGINS=http://localhost:3000

# Auth session cookie; set true behind HTTPS in production.
AGENCY_COOKIE_SECURE=false

# Server-side provider placeholders (names only; never commit credentials).
AGENCY_DATABASE_URL=sqlite:///agency.db
AGENCY_PROVIDER_MODE=mock
\n# LLM: mock for deterministic tests; local uses an OpenAI-compatible local endpoint.
AGENCY_LLM_PROVIDER=mock
AGENCY_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
AGENCY_LOCAL_LLM_MODEL=qwen3:0.6b
AGENCY_LOCAL_LLM_API_KEY=
\n# Lead notifications: console is offline-safe; smtp is optional for real deployments.
AGENCY_NOTIFY_PROVIDER=console
AGENCY_SMTP_HOST=
AGENCY_SMTP_PORT=587
AGENCY_SMTP_USERNAME=
AGENCY_SMTP_PASSWORD=
AGENCY_SMTP_FROM=
