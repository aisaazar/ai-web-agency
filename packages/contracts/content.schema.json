  "$id": "ai-web-agency/contracts/content.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One immutable content artifact revision (docs/DOMAIN-MODEL.md, artifact type `content_model`).",
  "properties": {
    "business": {
      "$ref": "#/$defs/Business"
    },
    "compliance": {
      "$ref": "#/$defs/Compliance"
    },
    "contact": {
      "$ref": "#/$defs/ContactSection"
    },
    "content_schema_version": {
      "description": "Enforced, not decorative (ADR-005). Templates declare the versions they support.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Content Schema Version",
      "type": "string"
    },
    "faq": {
      "$ref": "#/$defs/FaqSection"
    },
    "hero": {
      "$ref": "#/$defs/HeroSection"
    },
    "highlights": {
      "items": {
        "$ref": "#/$defs/Highlight"
      },
      "minItems": 1,
      "title": "Highlights",
      "type": "array"
    },
    "hours": {
      "$ref": "#/$defs/HoursSection"
    },
    "legal": {
      "$ref": "#/$defs/Legal"
    },
    "locale": {
      "pattern": "^[a-z]{2}-[A-Z]{2}$",
      "title": "Locale",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ContentMeta"
    },
    "seo": {
      "$ref": "#/$defs/Seo"
    },
    "services": {
      "$ref": "#/$defs/ServicesSection"
    },
    "site": {
      "$ref": "#/$defs/SiteIdentity"
    },
    "team": {
      "$ref": "#/$defs/TeamSection"
    }
  },
  "required": [
    "content_schema_version",
    "meta",
    "locale",
    "site",
    "business",
    "compliance",
    "hero",
    "highlights",
    "services",
    "team",
    "hours",
    "contact",
    "faq",
    "legal",
    "seo"
  ],
  "title": "ContentModel",
  "type": "object"
}
