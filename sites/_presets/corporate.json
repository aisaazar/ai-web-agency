      { "foreground": "surface", "background": "brand-700", "minRatio": 4.5, "usage": "primary button label, hover" },
      { "foreground": "brand-700", "background": "brand-50", "minRatio": 4.5, "usage": "text on tinted panels" },
      { "foreground": "accent-700", "background": "accent-100", "minRatio": 4.5, "usage": "badge text" },
      { "foreground": "accent-600", "background": "surface", "minRatio": 4.5, "usage": "accent text on white" },
