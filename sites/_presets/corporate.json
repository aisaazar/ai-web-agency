      "brand-100": "#DBEAFE",
      "brand-200": "#BFDBFE",
      "brand-300": "#93C5FD",
      "brand-400": "#60A5FA",
      "brand-500": "#3B82F6",
      "brand-600": "#1D4ED8",
      "brand-700": "#1E40AF",
      "brand-800": "#1E3A8A",      "accent-100": "#FEF3C7",
      "accent-600": "#92400E",
      "accent-700": "#78350F",
      "focus": "#1D4ED8"
    },
    "radius": {
